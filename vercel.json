{
  "version": 2,
  "functions": {
    "api/pages/[page].js": { "includeFiles": "server/{adverse-effects.html,data/adverse-effects.json,data/adverse-effects/**}" }
  },
  "rewrites": [
    { "source": "/browse", "destination": "/browse.html" },
    { "source": "/browse/", "destination": "/browse.html" },
    { "source": "/subscribe", "destination": "/subscribe.html" },
    { "source": "/subscribe/", "destination": "/subscribe.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/account/", "destination": "/account.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/refunds", "destination": "/refunds.html" },
    { "source": "/refunds/", "destination": "/refunds.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact/", "destination": "/contact.html" },
    { "source": "/api/account", "destination": "/api/auth/account" },
    { "source": "/api/admin/members", "destination": "/api/auth/members" },
    { "source": "/library", "destination": "/api/pages/library" },
    { "source": "/library/", "destination": "/api/pages/library" },
    { "source": "/adverse-effects", "destination": "/api/pages/adverse-effects" },
    { "source": "/adverse-effects/", "destination": "/api/pages/adverse-effects" },
    { "source": "/formulas", "destination": "/formulas.html" },
    { "source": "/formulas/", "destination": "/formulas.html" },
    { "source": "/research", "destination": "/research.html" },
    { "source": "/research/", "destination": "/research.html" },
    { "source": "/qtc", "destination": "/qtc.html" },
    { "source": "/qtc/", "destination": "/qtc.html" },
    { "source": "/admin", "destination": "/api/admin/page" },
    { "source": "/admin/", "destination": "/api/admin/page" },
    { "source": "/admin/index.html", "destination": "/api/admin/page" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" }
  ],
  "headers": [
    {
      "source": "/login",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/register",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/forgot-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/reset-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/admin/login",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/account",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/account/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/account.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), display-capture=(), browsing-topics=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Origin-Agent-Cluster", "value": "?1" }
      ]
    },
    {
      "source": "/((?!subscribe).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/subscribe",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://api.razorpay.com https://checkout.razorpay.com; img-src 'self' data: https://cdn.razorpay.com; object-src 'none'; script-src 'self' https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/subscribe/",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://api.razorpay.com https://checkout.razorpay.com; img-src 'self' data: https://cdn.razorpay.com; object-src 'none'; script-src 'self' https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/subscribe.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://api.razorpay.com https://checkout.razorpay.com; img-src 'self' data: https://cdn.razorpay.com; object-src 'none'; script-src 'self' https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
