PORT=3000
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-backend-only-secret-key

# Legacy Supabase key names remain supported during key rotation:
# SUPABASE_ANON_KEY=your-legacy-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-backend-only-service-role-key

# Razorpay (test keys start with rzp_test_). The secret stays on the server only.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
MEMBERSHIP_PRICE_INR=1
MEMBERSHIP_DAYS=30
# Set to true to make the library and Ask My Notes members-only
PAYWALL_ENABLED=false
